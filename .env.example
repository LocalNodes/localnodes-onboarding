# Coolify API (required for subdomain availability checks)
NUXT_COOLIFY_API_TOKEN=your_coolify_api_token_here

# Stripe (required for payment processing)
# Get from: Stripe Dashboard -> Developers -> API keys -> Secret key
NUXT_STRIPE_SECRET_KEY=sk_test_xxx
# Get from: Stripe Dashboard -> Developers -> Webhooks -> Signing secret
NUXT_STRIPE_WEBHOOK_SECRET=whsec_xxx
# Get from: Stripe Dashboard -> Products -> Your product -> Price ID
NUXT_STRIPE_PRICE_ID=price_xxx

# Upstash Redis (required for provisioning state tracking)
# Get from: Upstash Console -> Create Database -> REST URL
NUXT_UPSTASH_REDIS_URL=https://xxx.upstash.io
# Get from: Upstash Console -> Create Database -> REST Token
NUXT_UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxx

# GitHub Actions (required for provisioning workflow dispatch)
# Create fine-grained PAT with actions:write + metadata:read on LocalNodes/os-knowledge-garden
# Get from: GitHub -> Settings -> Developer Settings -> Fine-grained PATs
NUXT_GITHUB_TOKEN=github_pat_xxx
# Repository to dispatch provisioning workflow to
NUXT_GITHUB_REPO=LocalNodes/os-knowledge-garden

# Provisioning callback (shared secret for GitHub Actions to authenticate callbacks)
# Generate with: openssl rand -hex 32
NUXT_PROVISION_CALLBACK_SECRET=your_callback_secret_here
