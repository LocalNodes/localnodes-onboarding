# Coolify API (required for subdomain availability checks)
NUXT_COOLIFY_API_TOKEN=your_coolify_api_token_here

# Stripe (required for payment processing)
# Get from: Stripe Dashboard -> Developers -> API keys -> Secret key
NUXT_STRIPE_SECRET_KEY=sk_test_xxx
# Get from: Stripe Dashboard -> Developers -> Webhooks -> Signing secret
NUXT_STRIPE_WEBHOOK_SECRET=whsec_xxx
# Get from: Stripe Dashboard -> Products -> Your product -> Price ID
NUXT_STRIPE_PRICE_ID=price_xxx
# The currency of that price, three letters, lowercase (Stripe Dashboard -> the price -> Currency), for example usd.
# Checkout runs in setup mode and needs it. Empty refuses every checkout.
NUXT_STRIPE_CURRENCY=usd

# Upstash Redis (required for provisioning state tracking)
# Get from: Upstash Console -> Create Database -> REST URL
NUXT_UPSTASH_REDIS_URL=https://xxx.upstash.io
# Get from: Upstash Console -> Create Database -> REST Token
NUXT_UPSTASH_REDIS_TOKEN=AXxxxxxxxxxxxx

# GitHub Actions (required for provisioning workflow dispatch)
# Create fine-grained PAT with actions:write + metadata:read on LocalNodes/os-knowledge-garden
# Get from: GitHub -> Settings -> Developer Settings -> Fine-grained PATs
NUXT_GITHUB_TOKEN=github_pat_xxx
# Repository to dispatch provisioning workflow to
NUXT_GITHUB_REPO=LocalNodes/os-knowledge-garden

# Provisioning callback (shared secret for GitHub Actions to authenticate callbacks)
# Generate with: openssl rand -hex 32
NUXT_PROVISION_CALLBACK_SECRET=your_callback_secret_here

# Pre-launch gate: the paid sign-up flow (/onboarding, /success, /cancel and the
# checkout/provision API routes) opens only when this is true. Default closed.
# While closed, the Stripe webhook verifies signatures and acts on nothing.
NUXT_LAUNCH_OPEN=false

# Early-access list (Resend Contacts; "Audiences" are now "Segments")
# Get from: Resend -> API Keys (a key with full access to contacts)
NUXT_RESEND_API_KEY=re_xxx
# Get from: Resend -> Audience -> Segments -> your early-access segment's ID
NUXT_RESEND_SEGMENT_ID=xxxxxxxx-xxxx-xxxx-xxxx-xxxxxxxxxxxx

# --- Self-serve sign-up (Phase 23). Every key below is server-only: set it in
# the Vercel project env (production and preview). None is ever public.

# Invite list: HMAC key for the list's Redis keys, so an address can't be
# reversed from them. Generate with: openssl rand -hex 32. Keep it: changing it
# orphans every invite on the list.
NUXT_INVITE_HASH_SECRET=your_invite_hash_secret_here
# Verified Resend sender for the sign-in mail. Resend -> Domains, then use an
# address on a verified domain, for example: LocalNodes <hello@localnodes.xyz>
NUXT_MAIL_FROM=LocalNodes <hello@example.com>
# Product image tag the provisioning workflow pins. Leave empty for the workflow's default.
NUXT_PROVISION_IMAGE_TAG=
# Server room: bearer secret the server's metric push sends. Generate with: openssl rand -hex 32
NUXT_CAPACITY_REPORT_SECRET=your_capacity_report_secret_here
# Hard cap on running sites. 0 sells none until Tom sets a number.
NUXT_CAPACITY_MAX_SITES=0
# Memory one site is counted at, memory kept free on top, and least free Docker disk (GB).
NUXT_CAPACITY_PER_SITE_MB=2048
NUXT_CAPACITY_HEADROOM_MB=1024
NUXT_CAPACITY_MIN_DOCKER_FREE_GB=10
# Coolify server whose running apps are counted. Get from: Coolify -> Servers -> your server's UUID
NUXT_COOLIFY_SERVER_UUID=your_server_uuid_here
# The sweep's trigger (23-38). The two keys come from Upstash console -> QStash ->
# Signing keys (the values Upstash shows as its current and next signing keys).
# Empty values refuse every call.
NUXT_QSTASH_CURRENT_SIGNING_KEY=
NUXT_QSTASH_NEXT_SIGNING_KEY=
# Must equal the QStash schedule's destination exactly, for example
# https://<host>/api/cron/sweep, with no trailing slash or query. The schedule
# itself is created once by hand (23-21 runbook), never from code.
NUXT_CRON_SWEEP_URL=
# The B-2 gate (23-32): paid (not 100%-off) sign-ups are refused while this is false;
# set to true only after B-2 (pause and removal) ships.
NUXT_PAID_SIGNUPS_ENABLED=false
# The bring-your-own OpenRouter choice at sign-up (23-18 follow-up). Hidden, and refused by
# the key check and checkout, unless this is exactly true. Keep false until a model passes the bar.
NUXT_OPENROUTER_CHOICE_ENABLED=false
# Paid Gemini key for topic-type suggestions. Get from: Google AI Studio -> API keys (the billing-enabled project)
NUXT_GEMINI_API_KEY=your_gemini_api_key_here
# Gemini model id for those suggestions, for example gemini-3.8-flash
NUXT_GEMINI_MODEL=gemini-3.8-flash
# 32-byte secret that seals a customer's own AI key. Generate with: openssl rand -hex 32
NUXT_BYO_KEY_SECRET=your_byo_key_secret_here

# The host's address for a member's page report. Sent to every new site in the
# provision manifest (host_report_email) and set there as HOST_REPORT_EMAIL.
# Empty: the sites send page reports to their organizers only.
NUXT_HOST_REPORT_EMAIL=
