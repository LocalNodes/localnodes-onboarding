        "GPL-2.0-or-later",
        "AGPL-3.0-or-later"
      ],
      "short": "open source (GPL and AGPL)",
      "gplMention": "\\bGPL\\b|General Public License",
      "agplMention": "AGPL|Affero"
    },
    {
      "id": "demo-label",
      "rule": "Demo links say demo",
      "description": "Every link to a subdomain of the site host, other than the site itself and its sign-up routes, has \"demo\" in its text or aria-label (D-16)"
