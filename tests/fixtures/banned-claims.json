  "required": [
    {
      "id": "licence",
      "rule": "GPL without AGPL",
      "description": "The page names both GPL-2.0-or-later and AGPL-3.0-or-later, or says \"open source (GPL and AGPL)\". A page that mentions GPL (or General Public License) but never AGPL (or Affero) fails. D-16 (Tom, 2026-11-05)",
      "both": [
        "GPL-2.0-or-later",
        "AGPL-3.0-or-later"
      ],
      "short": "open source (GPL and AGPL)",
      "gplMention": "\\bGPL\\b|General Public License",
      "agplMention": "AGPL|Affero"
    },
    {
      "id": "prelaunch",
      "rule": "Pre-launch statement",
      "description": "The built page has at least one element with the data-prelaunch attribute whose visible text says \"Launching soon\" (Tom, 2026-11-06, PR #9: LocalNodes launches only when funds and votes are complete). No statement fails.",
      "attribute": "data-prelaunch",
      "phrase": "Launching soon"
    },
    {
      "id": "demo-label",
      "rule": "Demo links say demo",
      "description": "Every link to a subdomain of the site host, other than the site itself and its sign-up routes, has \"demo\" in its text or aria-label (D-16)"
    }
  ],
